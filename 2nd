<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FedEx SmartRecover | AI Command Center</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;700&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: { sans: ['Outfit', 'sans-serif'] },
                    colors: {
                        brand: { 500: '#4D148C', 600: '#3a0f6b' }, /* FedEx Purple */
                        accent: { 500: '#FF6600', 600: '#e65c00' }  /* FedEx Orange */
                    },
                    animation: {
                        'pulse-slow': 'pulse 3s infinite',
                        'scan': 'scan 2s linear infinite'
                    },
                    keyframes: {
                        scan: { '0%': { top: '0%' }, '100%': { top: '100%' } }
                    }
                }
            }
        }
    </script>
    <style>
        /* Glass Effect Styles */
        .glass { background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.5); }
        .dark .glass { background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255,255,255,0.1); color: white; }
        
        /* Scanner Animation Line */
        .scanner-line {
            position: absolute; width: 100%; height: 4px;
            background: linear-gradient(90deg, transparent, #FF6600, transparent);
            box-shadow: 0 0 15px #FF6600; z-index: 50; animation: scan 1.5s linear infinite;
        }
        
        body { transition: background-color 0.5s; }
    </style>
</head>
<body class="bg-slate-100 dark:bg-slate-900 text-slate-800 dark:text-slate-200 h-screen overflow-hidden transition-colors duration-500">

    <div id="app" class="flex w-full h-full relative">

        <div v-if="scanning" class="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex flex-col justify-center items-center">
            <div class="scanner-line top-0"></div>
            <div class="bg-black/90 text-white px-8 py-4 rounded-xl font-mono text-xl border border-accent-500 shadow-[0_0_30px_rgba(255,102,0,0.5)]">
                <i class="fas fa-microchip fa-spin mr-3"></i> AI ENGINE PROCESSING...
            </div>
        </div>

        <aside class="w-64 bg-white dark:bg-slate-950 border-r border-slate-200 dark:border-slate-800 flex flex-col z-20">
            <div class="h-20 flex items-center px-6 border-b border-slate-200 dark:border-slate-800">
                <div class="w-10 h-10 bg-brand-500 rounded-lg flex items-center justify-center text-white font-bold text-xl shadow-lg">SR</div>
                <div class="ml-3">
                    <h1 class="font-bold text-lg leading-tight">SmartRecover</h1>
                    <p class="text-xs text-accent-500 font-bold uppercase tracking-wider">FedEx Tool</p>
                </div>
            </div>

            <nav class="flex-1 py-6 px-3 space-y-2">
                <a @click="view='dash'" :class="navClass('dash')" class="flex items-center p-3 rounded-xl cursor-pointer transition-all hover:bg-slate-100 dark:hover:bg-slate-800">
                    <i class="fas fa-chart-pie w-6 text-center"></i>
                    <span class="ml-3 font-medium">Dashboard</span>
                </a>
                <a @click="view='cases'" :class="navClass('cases')" class="flex items-center p-3 rounded-xl cursor-pointer transition-all hover:bg-slate-100 dark:hover:bg-slate-800">
                    <i class="fas fa-table w-6 text-center"></i>
                    <span class="ml-3 font-medium">Data Manager</span>
                    <span v-if="cases.length" class="ml-auto text-[10px] bg-brand-500 text-white px-2 py-0.5 rounded-full">{{cases.length}}</span>
                </a>
                <a @click="view='audit'" :class="navClass('audit')" class="flex items-center p-3 rounded-xl cursor-pointer transition-all hover:bg-slate-100 dark:hover:bg-slate-800">
                    <i class="fas fa-shield-alt w-6 text-center"></i>
                    <span class="ml-3 font-medium">Governance Audit</span>
                </a>
            </nav>

            <div class="p-4 border-t border-slate-200 dark:border-slate-800">
                <button @click="toggleTheme" class="w-full p-2 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 transition flex items-center justify-center gap-2 text-sm font-medium">
                    <i :class="isDark ? 'fas fa-sun text-yellow-400' : 'fas fa-moon text-slate-500'"></i>
                    <span>{{ isDark ? 'Light Mode' : 'Dark Mode' }}</span>
                </button>
            </div>
        </aside>

        <main class="flex-1 flex flex-col h-full relative overflow-hidden bg-slate-50 dark:bg-slate-900">
            
            <header class="h-20 px-8 flex items-center justify-between z-10 bg-white/50 dark:bg-slate-900/50 backdrop-blur-md sticky top-0">
                <div>
                    <h2 class="text-2xl font-bold">{{ pageTitle }}</h2>
                    <p class="text-xs text-slate-500 flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span> SYSTEM ONLINE
                    </p>
                </div>
                <div class="flex items-center gap-4">
                    <button class="w-10 h-10 rounded-full bg-white dark:bg-slate-800 shadow-sm flex items-center justify-center relative">
                        <i class="fas fa-bell text-slate-400"></i>
                        <span class="absolute top-2 right-2 w-2 h-2 bg-red-500 rounded-full"></span>
                    </button>
                    <div class="w-10 h-10 rounded-full bg-gradient-to-r from-brand-500 to-purple-700 flex items-center justify-center text-white font-bold text-sm shadow-md">
                        AD
                    </div>
                </div>
            </header>

            <div class="flex-1 overflow-y-auto p-8 scroll-smooth">
                
                <div v-if="view === 'dash'" class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                        <div v-for="stat in stats" class="glass p-6 rounded-2xl border-l-4 shadow-sm" :class="stat.border">
                            <p class="text-xs font-bold uppercase opacity-60">{{ stat.label }}</p>
                            <h3 class="text-2xl font-bold mt-1">{{ stat.value }}</h3>
                            <div class="mt-2 text-xs font-medium flex items-center gap-1" :class="stat.trendColor">
                                <i :class="stat.trendIcon"></i> {{ stat.trend }}
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                        <div class="lg:col-span-2 glass p-6 rounded-2xl shadow-sm h-96">
                            <h3 class="font-bold mb-4 flex items-center gap-2"><i class="fas fa-chart-column text-brand-500"></i> Ageing Analysis (Days Overdue)</h3>
                            <div class="h-full pb-8 relative"><canvas id="barChart"></canvas></div>
                        </div>
                        <div class="glass p-6 rounded-2xl shadow-sm h-96">
                            <h3 class="font-bold mb-4 flex items-center gap-2"><i class="fas fa-chart-pie text-accent-500"></i> Risk Segmentation</h3>
                            <div class="h-full pb-8 relative"><canvas id="donutChart"></canvas></div>
                        </div>
                    </div>
                </div>

                <div v-if="view === 'cases'" class="space-y-4">
                    <div class="glass p-4 rounded-xl flex flex-wrap justify-between items-center gap-4 shadow-sm">
                        <div class="flex gap-3">
                            <button @click="$refs.fileInput.click()" class="bg-slate-800 text-white px-4 py-2 rounded-lg text-sm font-bold hover:bg-slate-700 transition flex items-center gap-2">
                                <i class="fas fa-file-excel"></i> Upload Excel
                                <input type="file" ref="fileInput" @change="handleFileUpload" class="hidden" accept=".xlsx,.csv">
                            </button>
                            
                            <button @click="showManualModal=true" class="bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 px-4 py-2 rounded-lg text-sm font-bold hover:bg-slate-50 transition flex items-center gap-2">
                                <i class="fas fa-plus"></i> Manual Entry
                            </button>

                            <button @click="generateDummyData" class="text-brand-500 px-4 py-2 text-sm font-bold hover:underline">
                                <i class="fas fa-magic"></i> Auto-Generate Data
                            </button>
                        </div>
                        
                        <button @click="runAI" :disabled="cases.length===0" class="bg-gradient-to-r from-brand-500 to-purple-600 text-white px-6 py-2 rounded-lg text-sm font-bold shadow-lg hover:shadow-xl transition flex items-center gap-2 disabled:opacity-50">
                            <i class="fas fa-brain"></i> Run AI Optimization
                        </button>
                    </div>

                    <div class="glass rounded-xl overflow-hidden shadow-sm border border-slate-200 dark:border-slate-700">
                        <table class="w-full text-sm text-left">
                            <thead class="bg-slate-50 dark:bg-slate-800 text-slate-500 uppercase font-bold text-xs">
                                <tr>
                                    <th class="p-4">Customer Name</th>
                                    <th class="p-4">Amount</th>
                                    <th class="p-4">Days Overdue</th>
                                    <th class="p-4">AI Score (Propensity)</th>
                                    <th class="p-4">Segment</th>
                                    <th class="p-4 text-right">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-if="cases.length === 0"><td colspan="6" class="p-10 text-center opacity-50">No Data Available. Upload or Generate Data.</td></tr>
                                <tr v-for="c in cases" :key="c.id" class="border-b border-slate-100 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition">
                                    <td class="p-4 font-bold">{{ c.Name }}<div class="text-[10px] font-mono opacity-50">{{ c.id }}</div></td>
                                    <td class="p-4 font-mono">{{ formatMoney(c.Amount) }}</td>
                                    <td class="p-4">
                                        <span class="px-2 py-1 rounded text-[10px] font-bold border" :class="daysClass(c.Days)">{{ c.Days }} Days</span>
                                    </td>
                                    <td class="p-4">
                                        <div v-if="c.processed" class="w-full max-w-[100px]">
                                            <div class="flex justify-between text-[10px] font-bold mb-1">
                                                <span>{{ c.score }}</span>
                                            </div>
                                            <div class="h-1.5 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden">
                                                <div class="h-full rounded-full" :class="scoreColor(c.score)" :style="{width: c.score+'%'}"></div>
                                            </div>
                                        </div>
                                        <span v-else class="text-xs italic opacity-50">Pending AI</span>
                                    </td>
                                    <td class="p-4">
                                        <span v-if="c.processed" class="text-xs font-bold" :class="segmentColor(c.segment)">{{ c.segment }}</span>
                                        <span v-else>-</span>
                                    </td>
                                    <td class="p-4 text-right">
                                        <button v-if="c.segment === 'A'" @click="sendNudge(c)" class="text-green-600 hover:underline text-xs font-bold">Auto-Email</button>
                                        <button v-if="c.segment === 'B'" class="text-orange-500 hover:underline text-xs font-bold">Assign Agent</button>
                                        <button v-if="c.segment === 'C'" class="text-red-500 hover:underline text-xs font-bold">Legal Hold</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div v-if="view === 'audit'" class="space-y-4">
                    <div class="glass p-6 rounded-2xl h-[calc(100vh-200px)] overflow-y-auto">
                        <h3 class="font-bold mb-4">Immutable System Logs</h3>
                        <div class="space-y-3">
                            <div v-for="log in auditLogs" class="p-3 border-b border-slate-100 dark:border-slate-700 flex justify-between">
                                <div>
                                    <span class="text-xs font-bold text-brand-500 block">{{ log.actor }}</span>
                                    <span class="text-sm">{{ log.action }}</span>
                                </div>
                                <span class="text-[10px] font-mono opacity-50">{{ log.time }}</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </main>

        <div v-if="showManualModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center">
            <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl w-96 shadow-2xl border dark:border-slate-700">
                <h3 class="font-bold text-lg mb-4">Add Single Case</h3>
                <div class="space-y-3">
                    <input v-model="newCase.Name" placeholder="Customer Name" class="w-full p-2 border rounded dark:bg-slate-800 dark:border-slate-700">
                    <input v-model="newCase.Amount" type="number" placeholder="Amount ($)" class="w-full p-2 border rounded dark:bg-slate-800 dark:border-slate-700">
                    <input v-model="newCase.Days" type="number" placeholder="Days Overdue" class="w-full p-2 border rounded dark:bg-slate-800 dark:border-slate-700">
                </div>
                <div class="mt-6 flex gap-2">
                    <button @click="showManualModal=false" class="flex-1 py-2 text-slate-500 text-sm">Cancel</button>
                    <button @click="addManualCase" class="flex-1 py-2 bg-brand-500 text-white rounded text-sm font-bold">Add</button>
                </div>
            </div>
        </div>

    </div>

    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    view: 'dash',
                    isDark: false,
                    scanning: false,
                    showManualModal: false,
                    cases: [],
                    auditLogs: [],
                    newCase: { Name: '', Amount: '', Days: '' },
                    chart1: null,
                    chart2: null
                }
            },
            computed: {
                pageTitle() {
                    return this.view === 'dash' ? 'Executive Dashboard' : (this.view === 'cases' ? 'Case Management' : 'Governance & Audit');
                },
                totalOut() { return this.cases.reduce((sum, c) => sum + Number(c.Amount), 0); },
                stats() {
                    return [
                        { label: 'Total Outstanding', value: this.formatMoney(this.totalOut), border: 'border-brand-500', trend: '+5%', trendIcon: 'fas fa-arrow-up', trendColor: 'text-red-500' },
                        { label: 'Cases Loaded', value: this.cases.length, border: 'border-blue-500', trend: 'Stable', trendIcon: 'fas fa-minus', trendColor: 'text-slate-500' },
                        { label: 'SLA Breaches', value: this.cases.filter(c => c.Days > 90).length, border: 'border-red-500', trend: 'Critical', trendIcon: 'fas fa-exclamation', trendColor: 'text-red-500' },
                        { label: 'AI Confidence', value: this.cases.length > 0 && this.cases[0].processed ? '94%' : '-', border: 'border-green-500', trend: 'High', trendIcon: 'fas fa-check', trendColor: 'text-green-500' }
                    ]
                }
            },
            methods: {
                navClass(v) { return this.view === v ? 'text-accent-500 bg-slate-50 dark:bg-slate-900 shadow-sm' : 'text-slate-500 hover:text-slate-800 dark:hover:text-white'; },
                formatMoney(v) { return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(v); },
                toggleTheme() { this.isDark = !this.isDark; document.documentElement.classList.toggle('dark'); },

                // DATA HANDLING
                generateDummyData() {
                    const names = ['Stark Ind', 'Wayne Ent', 'Acme Corp', 'Globex', 'Umbrella Corp', 'Cyberdyne'];
                    for(let i=0; i<10; i++) {
                        this.cases.push({
                            id: `FDX-${1000+i}`,
                            Name: names[Math.floor(Math.random()*names.length)],
                            Amount: Math.floor(Math.random()*50000)+500,
                            Days: Math.floor(Math.random()*120)+10,
                            processed: false, score: 0, segment: '-'
                        });
                    }
                    this.log('SYSTEM', 'Auto-generated 10 dummy records');
                    if(this.view==='dash') this.updateCharts();
                },
                addManualCase() {
                    if(!this.newCase.Name) return;
                    this.cases.push({
                        id: `FDX-${Math.floor(Math.random()*9000)+1000}`,
                        Name: this.newCase.Name,
                        Amount: Number(this.newCase.Amount),
                        Days: Number(this.newCase.Days),
                        processed: false, score: 0, segment: '-'
                    });
                    this.showManualModal=false;
                    this.newCase = { Name: '', Amount: '', Days: '' };
                    this.log('USER', 'Manual case entry added');
                },
                handleFileUpload(e) {
                    const file = e.target.files[0];
                    const reader = new FileReader();
                    reader.onload = (evt) => {
                        const wb = XLSX.read(evt.target.result, { type: 'array' });
                        const data = XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]]);
                        // Map loose headers to strict structure
                        this.cases = data.map((row, i) => ({
                            id: `FDX-${2000+i}`,
                            Name: row['Name'] || row['Customer'] || 'Unknown',
                            Amount: row['Amount'] || 0,
                            Days: row['Days'] || row['Overdue'] || 0,
                            processed: false, score: 0, segment: '-'
                        }));
                        this.log('SYSTEM', `Uploaded ${data.length} records from Excel`);
                        if(this.view==='dash') this.updateCharts();
                    };
                    reader.readAsArrayBuffer(file);
                },

                // AI LOGIC
                runAI() {
                    if(!this.cases.length) return;
                    this.scanning = true;
                    setTimeout(() => {
                        this.cases.forEach(c => {
                            c.processed = true;
                            // Logic: 100 - (Days * 0.5). Cap at 0.
                            c.score = Math.max(0, Math.round(100 - (c.Days * 0.6)));
                            if(c.score >= 80) c.segment = 'A';
                            else if(c.score >= 40) c.segment = 'B';
                            else c.segment = 'C';
                        });
                        this.cases.sort((a,b) => a.score - b.score);
                        this.scanning = false;
                        this.log('AI ENGINE', 'Risk Prioritization & Segmentation Complete');
                        if(this.view==='dash') this.updateCharts();
                    }, 1500);
                },

                sendNudge(c) {
                    // Mailto link for demo
                    const subject = `Payment Reminder: Ref ${c.id}`;
                    const body = `Dear ${c.Name}, your payment of $${c.Amount} is overdue.`;
                    window.location.href = `mailto:?subject=${subject}&body=${body}`;
                    this.log('RPA', `Automated Email Drafted for ${c.Name}`);
                },

                log(actor, msg) { this.auditLogs.unshift({ time: new Date().toLocaleTimeString(), actor, action: msg }); },

                // STYLING HELPERS
                daysClass(d) { return d > 90 ? 'bg-red-100 text-red-600 border-red-200' : (d > 60 ? 'bg-orange-100 text-orange-600 border-orange-200' : 'bg-green-100 text-green-600 border-green-200'); },
                scoreColor(s) { return s >= 80 ? 'bg-green-500' : (s >= 40 ? 'bg-orange-400' : 'bg-red-500'); },
                scoreBarColor(s) { return s >= 80 ? 'bg-green-500' : (s >= 40 ? 'bg-orange-400' : 'bg-red-500'); },
                segmentColor(s) { return s === 'A' ? 'text-green-600' : (s === 'B' ? 'text-orange-500' : 'text-red-500'); },

                // CHARTS
                initCharts() {
                    if(this.chart1) this.chart1.destroy();
                    if(this.chart2) this.chart2.destroy();
                    
                    const ctx1 = document.getElementById('barChart');
                    const ctx2 = document.getElementById('donutChart');
                    if(!ctx1 || !ctx2) return;

                    Chart.defaults.font.family = "'Outfit', sans-serif";

                    this.chart1 = new Chart(ctx1, {
                        type: 'bar',
                        data: { labels: ['<30', '30-60', '60-90', '90+'], datasets: [{ label: 'Cases', data: [0,0,0,0], backgroundColor: '#4D148C', borderRadius: 4 }] },
                        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
                    });

                    this.chart2 = new Chart(ctx2, {
                        type: 'doughnut',
                        data: { labels: ['A (Safe)', 'B (Watch)', 'C (Risk)'], datasets: [{ data: [1,1,1], backgroundColor: ['#22c55e', '#f97316', '#ef4444'], borderWidth: 0 }] },
                        options: { responsive: true, maintainAspectRatio: false, cutout: '70%', plugins: { legend: { position: 'right' } } }
                    });
                    this.updateCharts();
                },
                updateCharts() {
                    if(!this.chart1) return;
                    let d = [0,0,0,0], s = [0,0,0];
                    this.cases.forEach(c => {
                        if(c.Days<30) d[0]++; else if(c.Days<60) d[1]++; else if(c.Days<90) d[2]++; else d[3]++;
                        if(c.processed) { if(c.segment==='A') s[0]++; else if(c.segment==='B') s[1]++; else s[2]++; }
                    });
                    this.chart1.data.datasets[0].data = d;
                    this.chart1.update();
                    this.chart2.data.datasets[0].data = s;
                    this.chart2.update();
                }
            },
            mounted() { this.initCharts(); }
        }).mount('#app');
    </script>
</body>
</html>